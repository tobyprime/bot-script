{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bot-script/contracts/package.schema.json",
  "title": "bot.yaml（脚本包清单：参数契约自述；不含边界/凭据/存储路径）",
  "type": "object",
  "properties": {
    "name": { "type": "string", "minLength": 1, "description": "包名（缺省取目录名）" },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^.*\\.lua$" },
      "description": "入口 .lua 列表（相对包目录）；入口同目录的其它 .lua 自动进入 require 面"
    },
    "params": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/param" },
      "description": "参数契约：每项必须是 schema 对象（type 必填）；不再接受裸字面量"
    }
  },
  "required": ["scripts"],
  "additionalProperties": false,
  "definitions": {
    "paramType": {
      "enum": ["string", "number", "boolean", "blockpos", "region", "list<blockpos>", "json"]
    },
    "param": {
      "type": "object",
      "properties": {
        "type": { "$ref": "#/definitions/paramType" },
        "default": {},
        "required": { "type": "boolean" },
        "help": { "type": "string" },
        "visible": { "type": "boolean" }
      },
      "required": ["type"],
      "additionalProperties": false
    }
  }
}
